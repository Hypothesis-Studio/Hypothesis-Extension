{
  "id": "dracula",
  "name": "Dracula",
  "displayName": "Dracula",
  "version": "1.0.0",
  "description": "Official Dracula theme — a dark theme with vibrant, neon colors.",
  "author": "Hypothesis",
  "license": "MIT",
  "main": "extension.js",
  "engines": { "hypothesis": ">=0.1.0" },
  "activationEvents": ["*"],
  "contributes": {
    "themes": [
      { "id": "dracula", "label": "Dracula", "path": "themes/dracula.json", "uiTheme": "vs-dark" }
    ],
    "commands": [
      { "command": "dracula.activate", "title": "Activate Dracula" }
    ]
  },
  "keywords": ["theme", "dark", "dracula", "vampire", "purple"],
  "private": true,
  "scripts": { "build": "node build.mjs", "build:dev": "node build.mjs --dev" }
}
