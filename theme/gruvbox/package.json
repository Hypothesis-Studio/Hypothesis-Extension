{
  "id": "gruvbox",
  "name": "Gruvbox",
  "displayName": "Gruvbox",
  "version": "1.0.0",
  "description": "Retro groove color scheme with warm, earthy tones. Dark and Light variants.",
  "author": "Hypothesis",
  "license": "MIT",
  "main": "extension.js",
  "engines": { "hypothesis": ">=0.1.0" },
  "activationEvents": ["*"],
  "contributes": {
    "themes": [
      { "id": "gruvbox-dark", "label": "Gruvbox Dark", "path": "themes/gruvbox-dark.json", "uiTheme": "vs-dark" },
      { "id": "gruvbox-light", "label": "Gruvbox Light", "path": "themes/gruvbox-light.json", "uiTheme": "vs" }
    ],
    "commands": [
      { "command": "gruvbox.activateDark", "title": "Activate Gruvbox Dark" },
      { "command": "gruvbox.activateLight", "title": "Activate Gruvbox Light" }
    ]
  },
  "keywords": ["theme", "dark", "light", "gruvbox", "retro", "warm"],
  "private": true,
  "scripts": { "build": "node build.mjs", "build:dev": "node build.mjs --dev" }
}
