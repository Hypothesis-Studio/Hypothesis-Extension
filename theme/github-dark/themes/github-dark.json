      "settings": {
        "foreground": "#ff7b72"
      }
    },
    {
      "scope": "export",
      "settings": {
        "foreground": "#ff7b72"
      }
    },
    {
      "scope": "control",
      "settings": {
        "foreground": "#ff7b72"
      }
    },
    {
      "scope": "modifier",
      "settings": {
        "foreground": "#ff7b72"
      }
