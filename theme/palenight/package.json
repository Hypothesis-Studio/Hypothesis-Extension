{
    "id":  "palenight",
    "name":  "Palenight",
    "displayName":  "Palenight",
    "version":  "1.0.0",
    "description":  "An elegant and juicy material-like theme with a night sky feel.",
    "author":  "Hypothesis",
    "license":  "MIT",
    "main":  "extension.js",
    "engines":  {
                    "hypothesis":  "\u003e=0.1.0"
                },
    "activationEvents":  [
                             "*"
                         ],
